  "CrewAI Basic Setup": {
    "prefix": "crew-basic-setup",
    "body": [
      "#!/usr/bin/env python3",
      "import os",
      "from crewai import Agent, Task, Crew, Process",
      "from crewai.tools import tool",
      "",
      "# Environment setup",
      "os.environ[\"OPENAI_API_KEY\"] = \"${1:your_openai_api_key}\"",
      "",
      "# Define custom tool",
      "@tool(\"${2:custom_tool}\")",
      "def ${3:custom_function}(${4:input_param}: str) -> str:",
      "    \"\"\"${5:Tool description}\"\"\"",
      "    return f\"Processed: {${4:input_param}}\"",
      "",
      "# Create agents",
      "${6:researcher} = Agent(",
      "    role='${7:Researcher}',",
      "    goal='${8:Research and analyze information}',",
      "    backstory='${9:Expert researcher with analytical skills}',",
      "    tools=[${3:custom_function}],",
      "    verbose=True",
      ")",
      "",
      "${10:writer} = Agent(",
      "    role='${11:Writer}',",
      "    goal='${12:Create engaging content}',",
      "    backstory='${13:Skilled writer with creative abilities}',",
      "    verbose=True",
      ")",
      "",
      "# Define tasks",
      "${14:research_task} = Task(",
      "    description='${15:Research the given topic thoroughly}',",
      "    agent=${6:researcher},",
      "    expected_output='${16:Detailed research report}'",
      ")",
      "",
      "${17:writing_task} = Task(",
      "    description='${18:Write an article based on research}',",
      "    agent=${10:writer},",
      "    expected_output='${19:Well-written article}',",
      "    context=[${14:research_task}]",
      ")",
      "",
      "# Create and run crew",
      "crew = Crew(",
      "    agents=[${6:researcher}, ${10:writer}],",
      "    tasks=[${14:research_task}, ${17:writing_task}],",
      "    process=Process.sequential,",
      "    verbose=2",
      ")",
      "",
      "# Execute",
      "if __name__ == \"__main__\":",
      "    result = crew.kickoff()",
      "    print(result)"
    ],
    "description": "Create a complete CrewAI project setup"
  },
